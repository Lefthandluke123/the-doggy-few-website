{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      { "source": "/index.html", "destination": "/", "type": 301 },
      { "source": "/home.php", "destination": "/", "type": 301 },
      { "source": "/en/**", "destination": "/", "type": 301 },
      { "source": "**/*.php", "destination": "/", "type": 301 }
    ],
    "rewrites": [
      {
        "source": "/",
        "function": {
          "functionId": "serveSnapshot",
          "region": "europe-west1"
        }
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ]
}
